{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-trust-box {% if block.settings.show_border %}vision-glass{% endif %}" style="background-color: {{ block.settings.bg_color | default: 'transparent' }};">
    {% if block.settings.title != blank %}
      <p style="text-align: center; font-weight: 700; font-size: 15px; margin: 0 0 16px 0; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings.title }}</p>
    {% endif %}
    <div class="vision-trust-grid">
      {%- for i in (1..4) -%}
        {%- assign icon_setting = 'badge_' | append: i | append: '_icon' -%}
        {%- assign text_setting = 'badge_' | append: i | append: '_text' -%}
        
        {%- if block.settings[text_setting] != blank -%}
          <div class="vision-trust-badge">
            <div class="vision-trust-icon" style="color: {{ block.settings.icon_color | default: '#10b981' }}; width: {{ block.settings.icon_size | default: 32 }}px; height: {{ block.settings.icon_size | default: 32 }}px;">
              {%- case block.settings[icon_setting] -%}
                {%- when 'shield-check' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>
                {%- when 'truck' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                {%- when 'arrow-path' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                {%- when 'star' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.536a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              {%- endcase -%}
            </div>
            <span class="vision-trust-text" style="font-size: {{ block.settings.text_size | default: 13 }}px; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings[text_setting] }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{"name":"Güven Rozetleri","target":"section","stylesheet":"vision-ui.css","settings":[{"type":"text","id":"title","label":"Başlık","default":"Neden Bizi Tercih Etmelisiniz?"},{"type":"header","content":"Rozet 1"},{"type":"select","id":"badge_1_icon","label":"İkon","options":[{"value":"shield-check","label":"Güvenli Ödeme"},{"value":"truck","label":"Hızlı Kargo"},{"value":"arrow-path","label":"Kolay İade"},{"value":"star","label":"Yüksek Kalite"}],"default":"shield-check"},{"type":"text","id":"badge_1_text","label":"Metin","default":"256-Bit SSL Güvenli Ödeme"},{"type":"header","content":"Rozet 2"},{"type":"select","id":"badge_2_icon","label":"İkon","options":[{"value":"shield-check","label":"Güvenli Ödeme"},{"value":"truck","label":"Hızlı Kargo"},{"value":"arrow-path","label":"Kolay İade"},{"value":"star","label":"Yüksek Kalite"}],"default":"truck"},{"type":"text","id":"badge_2_text","label":"Metin","default":"Aynı Gün Kargo"},{"type":"header","content":"Rozet 3"},{"type":"select","id":"badge_3_icon","label":"İkon","options":[{"value":"shield-check","label":"Güvenli Ödeme"},{"value":"truck","label":"Hızlı Kargo"},{"value":"arrow-path","label":"Kolay İade"},{"value":"star","label":"Yüksek Kalite"}],"default":"arrow-path"},{"type":"text","id":"badge_3_text","label":"Metin","default":"14 Gün Kolay İade"},{"type":"header","content":"Rozet 4"},{"type":"select","id":"badge_4_icon","label":"İkon","options":[{"value":"shield-check","label":"Güvenli Ödeme"},{"value":"truck","label":"Hızlı Kargo"},{"value":"arrow-path","label":"Kolay İade"},{"value":"star","label":"Yüksek Kalite"},{"value":"none","label":"Yok"}],"default":"star"},{"type":"text","id":"badge_4_text","label":"Metin","default":"%100 Orijinal Ürün"},{"type":"header","content":"Stil Ayarları"},{"type":"range","id":"icon_size","min":24,"max":56,"step":4,"unit":"px","label":"İkon Boyutu","default":32},{"type":"range","id":"text_size","min":11,"max":16,"step":1,"unit":"px","label":"Metin Boyutu","default":13},{"type":"color","id":"icon_color","label":"İkon Rengi","default":"#10b981"},{"type":"color","id":"text_color","label":"Yazı Rengi","default":"#0f172a"},{"type":"checkbox","id":"show_border","label":"Kart Kenarlığı Göster","default":true},{"type":"color","id":"bg_color","label":"Arka Plan Rengi","default":"#ffffff"}]}
{% endschema %}
