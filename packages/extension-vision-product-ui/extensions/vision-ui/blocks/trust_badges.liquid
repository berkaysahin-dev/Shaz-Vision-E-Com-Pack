{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .vision-trust-badges-{{ block.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: {{ block.settings.alignment }};
    padding: {{ block.settings.padding }}px 0;
  }
  .vision-trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    width: {{ block.settings.badge_width }}px;
  }
  .vision-trust-badge-icon {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }
  .vision-trust-badge-icon svg {
    width: 100%;
    height: 100%;
  }
  .vision-trust-badge-text {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }
  
  {% if block.settings.show_border %}
  .vision-trust-badges-wrapper-{{ block.id }} {
    padding: 16px;
    background-color: {{ block.settings.bg_color }};
    border-radius: var(--vision-radius-xl);
  }
  {% endif %}
{%- endstyle -%}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-trust-badges-wrapper-{{ block.id }} {% if block.settings.show_border %}vision-glass{% endif %}">
  {% if block.settings.title != blank %}
    <p class="vision-text-sm vision-font-bold vision-text-center" style="margin-bottom: 12px; color: {{ block.settings.text_color }};">{{ block.settings.title }}</p>
  {% endif %}
  <div class="vision-trust-badges-{{ block.id }}">
    {%- for i in (1..4) -%}
      {%- assign icon_setting = 'badge_' | append: i | append: '_icon' -%}
      {%- assign text_setting = 'badge_' | append: i | append: '_text' -%}
      
      {%- if block.settings[text_setting] != blank -%}
        <div class="vision-trust-badge">
          <div class="vision-trust-badge-icon">
            {%- case block.settings[icon_setting] -%}
              {%- when 'shield-check' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>
              {%- when 'truck' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
              {%- when 'arrow-path' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
              {%- when 'star' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.536a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
              {%- else -%}
                <!-- default circle -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            {%- endcase -%}
          </div>
          <span class="vision-trust-badge-text">{{ block.settings[text_setting] }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "target": "section",
  "stylesheet": "vision-ui.css",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why buy from us?"
    },
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "select",
      "id": "badge_1_icon",
      "label": "Icon",
      "options": [
        {"value": "shield-check", "label": "Secure"},
        {"value": "truck", "label": "Shipping"},
        {"value": "arrow-path", "label": "Returns"},
        {"value": "star", "label": "Quality"}
      ],
      "default": "shield-check"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Text",
      "default": "Secure Checkout"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "select",
      "id": "badge_2_icon",
      "label": "Icon",
      "options": [
        {"value": "shield-check", "label": "Secure"},
        {"value": "truck", "label": "Shipping"},
        {"value": "arrow-path", "label": "Returns"},
        {"value": "star", "label": "Quality"}
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Text",
      "default": "Fast Shipping"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "select",
      "id": "badge_3_icon",
      "label": "Icon",
      "options": [
        {"value": "shield-check", "label": "Secure"},
        {"value": "truck", "label": "Shipping"},
        {"value": "arrow-path", "label": "Returns"},
        {"value": "star", "label": "Quality"}
      ],
      "default": "arrow-path"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Text",
      "default": "Easy Returns"
    },
    {
      "type": "header",
      "content": "Badge 4"
    },
    {
      "type": "select",
      "id": "badge_4_icon",
      "label": "Icon",
      "options": [
        {"value": "shield-check", "label": "Secure"},
        {"value": "truck", "label": "Shipping"},
        {"value": "arrow-path", "label": "Returns"},
        {"value": "star", "label": "Quality"},
        {"value": "none", "label": "None"}
      ],
      "default": "star"
    },
    {
      "type": "text",
      "id": "badge_4_text",
      "label": "Text",
      "default": "Satisfaction"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {"value": "flex-start", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "flex-end", "label": "Right"},
        {"value": "space-around", "label": "Space Around"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icon Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_width",
      "min": 60,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Badge Width",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 16
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#10b981"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Border Box",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
