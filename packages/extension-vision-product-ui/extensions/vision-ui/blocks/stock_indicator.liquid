{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .vision-stock-{{ block.id }} {
    padding: {{ block.settings.padding }}px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vision-stock-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .vision-stock-icon {
    width: 20px;
    height: 20px;
    color: {{ block.settings.color }};
  }
  .vision-stock-text {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }
  .vision-stock-bar-bg {
    width: 100%;
    height: {{ block.settings.bar_height }}px;
    background-color: var(--vision-color-border);
    border-radius: var(--vision-radius-full);
    overflow: hidden;
  }
  .vision-stock-bar-fill {
    height: 100%;
    width: {{ block.settings.stock_percentage }}%;
    background-color: {{ block.settings.color }};
    border-radius: var(--vision-radius-full);
    transition: width 1s ease-out;
  }
  
  {% if block.settings.animate %}
  .vision-stock-pulse {
    animation: visionPulse 2s infinite;
  }
  {% endif %}
{%- endstyle -%}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-stock-{{ block.id }}">
    <div class="vision-stock-header">
      {% if block.settings.show_icon %}
        <div class="vision-stock-icon {% if block.settings.animate %}vision-stock-pulse{% endif %}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.176 7.547 7.547 0 0 1-1.705-1.715.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248ZM15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1a5.99 5.99 0 0 1 1.925-3.546 3.75 3.75 0 0 1 3.255 3.718Z" clip-rule="evenodd" /></svg>
        </div>
      {% endif %}
      <span class="vision-stock-text">
        {{ block.settings.message | replace: '[stock]', block.settings.stock_number }}
      </span>
    </div>
    
    {% if block.settings.show_bar %}
      <div class="vision-stock-bar-bg">
        <div class="vision-stock-bar-fill"></div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Stock Indicator",
  "target": "section",
  "stylesheet": "vision-ui.css",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Hurry! Only [stock] left in stock.",
      "info": "Use [stock] to insert the stock number."
    },
    {
      "type": "number",
      "id": "stock_number",
      "label": "Simulated Stock Number",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Fire Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show Progress Bar",
      "default": true
    },
    {
      "type": "range",
      "id": "stock_percentage",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bar Fill Percentage",
      "default": 15
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Accent Color",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 4,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Bar Height",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 16
    }
  ]
}
{% endschema %}
