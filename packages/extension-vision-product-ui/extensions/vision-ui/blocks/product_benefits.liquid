{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-benefits-box vision-glass" style="display: flex; flex-direction: {{ block.settings.layout | default: 'column' }}; gap: {{ block.settings.gap | default: 16 }}px; background: {{ block.settings.bg_color | default: 'transparent' }};">
    {%- for i in (1..3) -%}
      {%- assign title_setting = 'benefit_' | append: i | append: '_title' -%}
      {%- assign desc_setting = 'benefit_' | append: i | append: '_desc' -%}
      {%- assign icon_setting = 'benefit_' | append: i | append: '_icon' -%}
      
      {%- if block.settings[title_setting] != blank -%}
        <div class="vision-benefit-item">
          <div class="vision-benefit-icon" style="color: {{ block.settings.icon_color | default: '#10b981' }}; background-color: {{ block.settings.icon_bg_color | default: '#ecfdf5' }}; width: {{ block.settings.icon_size | default: 40 }}px; height: {{ block.settings.icon_size | default: 40 }}px;">
             {%- case block.settings[icon_setting] -%}
              {%- when 'check' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              {%- when 'sparkles' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09l2.846.813-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>
              {%- when 'heart' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            {%- endcase -%}
          </div>
          <div class="vision-benefit-content">
            <span class="vision-benefit-title" style="font-size: {{ block.settings.title_size | default: 15 }}px; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings[title_setting] }}</span>
            {%- if block.settings[desc_setting] != blank -%}
              <span class="vision-benefit-desc" style="font-size: {{ block.settings.desc_size | default: 13 }}px; color: {{ block.settings.text_color | default: '#64748b' }};">{{ block.settings[desc_setting] }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{"name":"Ürün Avantajları","target":"section","stylesheet":"vision-ui.css","settings":[{"type":"header","content":"Avantaj 1"},{"type":"select","id":"benefit_1_icon","label":"İkon","options":[{"value":"check","label":"Onay"},{"value":"sparkles","label":"Yıldız"},{"value":"heart","label":"Kalp"}],"default":"sparkles"},{"type":"text","id":"benefit_1_title","label":"Başlık","default":"Premium Kalite"},{"type":"text","id":"benefit_1_desc","label":"Açıklama","default":"En kaliteli malzemelerle üretilmiştir."},{"type":"header","content":"Avantaj 2"},{"type":"select","id":"benefit_2_icon","label":"İkon","options":[{"value":"check","label":"Onay"},{"value":"sparkles","label":"Yıldız"},{"value":"heart","label":"Kalp"}],"default":"check"},{"type":"text","id":"benefit_2_title","label":"Başlık","default":"Hızlı & Güvenli Kargo"},{"type":"text","id":"benefit_2_desc","label":"Açıklama","default":"Sigortalı ve özenli paketleme."},{"type":"header","content":"Avantaj 3"},{"type":"select","id":"benefit_3_icon","label":"İkon","options":[{"value":"check","label":"Onay"},{"value":"sparkles","label":"Yıldız"},{"value":"heart","label":"Kalp"}],"default":"heart"},{"type":"text","id":"benefit_3_title","label":"Başlık","default":"Müşteri Memnuniyeti"},{"type":"text","id":"benefit_3_desc","label":"Açıklama","default":"10.000+ mutlu müşteri yorumu."},{"type":"header","content":"Görünüm"},{"type":"select","id":"layout","label":"Yerleşim","options":[{"value":"column","label":"Alt Alta (Dikey)"},{"value":"row","label":"Yan Yana (Yatay)"}],"default":"column"},{"type":"range","id":"gap","min":8,"max":32,"step":4,"unit":"px","label":"Boşluk","default":16},{"type":"color","id":"icon_color","label":"İkon Rengi","default":"#10b981"},{"type":"color","id":"icon_bg_color","label":"İkon Arka Planı","default":"#ecfdf5"},{"type":"color","id":"text_color","label":"Metin Rengi","default":"#0f172a"}]}
{% endschema %}
