{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .vision-benefits-{{ block.id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px 0;
  }
  .vision-benefit-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vision-benefit-icon {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: var(--vision-radius-full);
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vision-benefit-icon svg {
    width: 100%;
    height: 100%;
  }
  .vision-benefit-content {
    display: flex;
    flex-direction: column;
  }
  .vision-benefit-title {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
  }
  .vision-benefit-desc {
    font-size: {{ block.settings.desc_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin-top: 4px;
    line-height: 1.4;
  }
{%- endstyle -%}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-benefits-{{ block.id }} vision-glass" style="border-radius: var(--vision-radius-xl); padding: 24px; background: {{ block.settings.bg_color | default: 'transparent' }};">
    {%- for i in (1..3) -%}
      {%- assign title_setting = 'benefit_' | append: i | append: '_title' -%}
      {%- assign desc_setting = 'benefit_' | append: i | append: '_desc' -%}
      {%- assign icon_setting = 'benefit_' | append: i | append: '_icon' -%}
      
      {%- if block.settings[title_setting] != blank -%}
        <div class="vision-benefit-item">
          <div class="vision-benefit-icon">
             {%- case block.settings[icon_setting] -%}
              {%- when 'check' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              {%- when 'sparkles' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09l2.846.813-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>
              {%- when 'heart' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            {%- endcase -%}
          </div>
          <div class="vision-benefit-content">
            <span class="vision-benefit-title">{{ block.settings[title_setting] }}</span>
            {%- if block.settings[desc_setting] != blank -%}
              <span class="vision-benefit-desc">{{ block.settings[desc_setting] }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Benefits",
  "target": "section",
  "stylesheet": "vision-ui.css",
  "settings": [
    {
      "type": "header",
      "content": "Benefit 1"
    },
    {
      "type": "select",
      "id": "benefit_1_icon",
      "label": "Icon",
      "options": [
        {"value": "check", "label": "Checkmark"},
        {"value": "sparkles", "label": "Sparkles"},
        {"value": "heart", "label": "Heart"}
      ],
      "default": "sparkles"
    },
    {
      "type": "text",
      "id": "benefit_1_title",
      "label": "Title",
      "default": "Premium Quality"
    },
    {
      "type": "text",
      "id": "benefit_1_desc",
      "label": "Description",
      "default": "Made with the finest materials."
    },
    {
      "type": "header",
      "content": "Benefit 2"
    },
    {
      "type": "select",
      "id": "benefit_2_icon",
      "label": "Icon",
      "options": [
        {"value": "check", "label": "Checkmark"},
        {"value": "sparkles", "label": "Sparkles"},
        {"value": "heart", "label": "Heart"}
      ],
      "default": "check"
    },
    {
      "type": "text",
      "id": "benefit_2_title",
      "label": "Title",
      "default": "Eco-Friendly"
    },
    {
      "type": "text",
      "id": "benefit_2_desc",
      "label": "Description",
      "default": "100% sustainable packaging."
    },
    {
      "type": "header",
      "content": "Benefit 3"
    },
    {
      "type": "select",
      "id": "benefit_3_icon",
      "label": "Icon",
      "options": [
        {"value": "check", "label": "Checkmark"},
        {"value": "sparkles", "label": "Sparkles"},
        {"value": "heart", "label": "Heart"}
      ],
      "default": "heart"
    },
    {
      "type": "text",
      "id": "benefit_3_title",
      "label": "Title",
      "default": "Customer Loved"
    },
    {
      "type": "text",
      "id": "benefit_3_desc",
      "label": "Description",
      "default": "Over 10,000 happy customers."
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {"value": "column", "label": "List (Vertical)"},
        {"value": "row", "label": "Row (Horizontal)"}
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icon Box Size",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#10b981"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#ecfdf5"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Description Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    }
  ]
}
{% endschema %}
