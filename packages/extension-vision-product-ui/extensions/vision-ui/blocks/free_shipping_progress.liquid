{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .vision-shipping-{{ block.id }} {
    padding: 24px;
    background: {{ block.settings.bg_color }};
    border-radius: var(--vision-radius-lg);
  }
  .vision-shipping-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 16px;
  }
  .vision-shipping-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--vision-color-text);
  }
  .vision-shipping-icon {
    width: 24px; height: 24px;
    color: {{ block.settings.bar_color }};
  }
  .vision-shipping-bar-bg {
    width: 100%;
    height: 10px;
    background: var(--vision-color-border);
    border-radius: var(--vision-radius-full);
    overflow: hidden;
    position: relative;
  }
  .vision-shipping-bar-fill {
    height: 100%;
    background: {{ block.settings.bar_color }};
    border-radius: var(--vision-radius-full);
    width: 0%;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }
  .vision-shipping-bar-fill::after {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0; right: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    animation: visionShine 2s infinite;
  }
  @keyframes visionShine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
{%- endstyle -%}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-shipping-{{ block.id }} vision-glass">
    <div class="vision-shipping-header">
      <div class="vision-shipping-title">
        <span id="v-ship-msg-{{ block.id }}">Loading...</span>
      </div>
      <svg class="vision-shipping-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
    </div>
    <div class="vision-shipping-bar-bg">
      <div class="vision-shipping-bar-fill" id="v-ship-bar-{{ block.id }}"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const threshold = {{ block.settings.threshold }};
    const cartValue = {{ block.settings.simulated_cart_value }}; // In a real scenario, this would use Shopify's /cart.js API
    const currency = '{{ block.settings.currency_symbol }}';
    
    const msgEl = document.getElementById('v-ship-msg-{{ block.id }}');
    const barEl = document.getElementById('v-ship-bar-{{ block.id }}');
    
    setTimeout(() => {
      if (cartValue >= threshold) {
        msgEl.innerHTML = '🎉 You unlocked <strong>Free Shipping!</strong>';
        barEl.style.width = '100%';
        barEl.style.background = 'var(--vision-color-success)';
      } else {
        const remaining = threshold - cartValue;
        msgEl.innerHTML = `You're only <strong>${currency}${remaining}</strong> away from Free Shipping.`;
        barEl.style.width = `${(cartValue / threshold) * 100}%`;
      }
    }, 500); // Slight delay for animation effect
  });
</script>

{% schema %}
{"name":"Free Shipping Progress","target":"section","stylesheet":"vision-ui.css","settings":[{"type":"number","id":"threshold","label":"Free Shipping Threshold","default":100},{"type":"number","id":"simulated_cart_value","label":"Simulated Cart Value","info":"Used to preview the progress bar in the editor.","default":75},{"type":"text","id":"currency_symbol","label":"Currency Symbol","default":"$"},{"type":"color","id":"bar_color","label":"Progress Bar Color","default":"#3b82f6"},{"type":"color","id":"bg_color","label":"Background Color","default":"#ffffff"}]}
{% endschema %}
