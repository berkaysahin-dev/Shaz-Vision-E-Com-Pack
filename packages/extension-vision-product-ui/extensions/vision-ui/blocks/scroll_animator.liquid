<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Inject global styles for scroll animations
    const style = document.createElement('style');
    style.innerHTML = `
      .vision-reveal-element {
        opacity: 0;
        transform: translateY(40px);
        transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .vision-reveal-element.vision-revealed {
        opacity: 1;
        transform: translateY(0);
      }
      /* Optional: Add zooming/scaling reveal */
      .vision-reveal-scale {
        opacity: 0;
        transform: scale(0.9);
        transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .vision-reveal-scale.vision-revealed {
        opacity: 1;
        transform: scale(1);
      }
    `;
    document.head.appendChild(style);

    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('vision-revealed');
          // Optional: Stop observing once revealed
          // observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // If the merchant enables global animations, we apply the class to main Shopify sections automatically
    {% if block.settings.animate_entire_page %}
      const shopifySections = document.querySelectorAll('.shopify-section');
      shopifySections.forEach((section, index) => {
        if(index > 0) { // skip the very first section (header) so it doesn't pop in weirdly
          section.classList.add('vision-reveal-element');
          observer.observe(section);
        }
      });
    {% endif %}

    // Observe specific elements if merchant adds classes manually
    const customElements = document.querySelectorAll('.vision-animate-scroll');
    customElements.forEach(el => {
      el.classList.add('vision-reveal-element');
      observer.observe(el);
    });
  });
</script>

{% schema %}
{"name":"Global Scroll Animator","target":"head","settings":[{"type":"paragraph","content":"This invisible block adds premium Apple-style scroll reveal animations to your entire storefront."},{"type":"checkbox","id":"animate_entire_page","label":"Auto-animate all sections","info":"Automatically adds a smooth fade-in-up effect to all Shopify sections as you scroll down the page.","default":true}]}
{% endschema %}
