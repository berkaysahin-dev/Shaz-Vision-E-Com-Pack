{{ 'vision-ui.css' | asset_url | stylesheet_tag }}

<div class="vision-block" {{ block.shopify_attributes }}>
  <div class="vision-timeline-card" style="background: {{ block.settings.bg_color | default: '#ffffff' }}; border-color: {{ block.settings.border_color | default: '#e2e8f0' }}; border-radius: {{ block.settings.border_radius | default: 16 }}px; padding: {{ block.settings.card_padding | default: 20 }}px; margin-bottom: {{ block.settings.margin_bottom | default: 16 }}px;">
    <div class="vision-timeline-header">
      <div class="vision-timeline-title-wrap">
        <svg class="vision-timeline-title-icon" style="color: {{ block.settings.active_color | default: '#6366f1' }};" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
        <span class="vision-timeline-title-text" style="font-size: {{ block.settings.title_size | default: 15 }}px; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings.title | default: 'Beklenen Teslimat Süreci' }}</span>
      </div>
      <div class="vision-timeline-badge">
        <span class="vision-timeline-badge-dot"></span>
        <span>{{ block.settings.badge_text | default: 'Hızlı Kargo: 1-3 İş Günü' }}</span>
      </div>
    </div>
    
    <div class="vision-timeline-track-wrap">
      <div class="vision-timeline-bar-bg"></div>
      <div class="vision-timeline-bar-fill" style="width: {{ block.settings.progress | default: 50 | times: 0.70 }}%; background: linear-gradient(90deg, {{ block.settings.active_color | default: '#6366f1' }}, #8b5cf6);"></div>
      
      <div class="vision-timeline-steps">
        <div class="vision-timeline-step">
          <div class="vision-timeline-dot active" style="border-color: {{ block.settings.active_color | default: '#6366f1' }};">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
          </div>
          <span class="vision-timeline-step-title" style="font-size: {{ block.settings.step_size | default: 13 }}px; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings.label_ordered | default: 'Sipariş Alındı' }}</span>
          <span class="vision-timeline-step-date">{{ block.settings.today_text | default: 'Bugün' }}</span>
        </div>
        
        <div class="vision-timeline-step">
          <div class="vision-timeline-dot {% if block.settings.progress >= 50 %}active{% endif %}" {% if block.settings.progress >= 50 %}style="border-color: {{ block.settings.active_color | default: '#6366f1' }};"{% endif %}>
            {% if block.settings.progress >= 50 %}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
            {% endif %}
          </div>
          <span class="vision-timeline-step-title" style="font-size: {{ block.settings.step_size | default: 13 }}px; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings.label_shipped | default: 'Kargoya Verildi' }}</span>
          <span class="vision-timeline-step-date">{{ block.settings.shipped_date | default: '1-2 gün içinde' }}</span>
        </div>
        
        <div class="vision-timeline-step">
          <div class="vision-timeline-dot {% if block.settings.progress >= 100 %}active{% endif %}" {% if block.settings.progress >= 100 %}style="border-color: {{ block.settings.active_color | default: '#6366f1' }};"{% endif %}>
            {% if block.settings.progress >= 100 %}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
            {% endif %}
          </div>
          <span class="vision-timeline-step-title" style="font-size: {{ block.settings.step_size | default: 13 }}px; color: {{ block.settings.text_color | default: '#0f172a' }};">{{ block.settings.label_delivered | default: 'Teslim Edildi' }}</span>
          <span class="vision-timeline-step-date">{{ block.settings.delivered_date | default: '3-5 gün içinde' }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{"name":"Teslimat Süreci","target":"section","stylesheet":"vision-ui.css","settings":[{"type":"text","id":"title","label":"Başlık","default":"Beklenen Teslimat Süreci"},{"type":"text","id":"badge_text","label":"Rozet Metni","default":"Hızlı Kargo: 1-3 İş Günü"},{"type":"range","id":"progress","min":0,"max":100,"step":10,"unit":"%","label":"İlerleme Seviyesi","default":50},{"type":"text","id":"label_ordered","label":"1. Aşama","default":"Sipariş Alındı"},{"type":"text","id":"today_text","label":"1. Aşama Alt Metni","default":"Bugün"},{"type":"text","id":"label_shipped","label":"2. Aşama","default":"Kargoya Verildi"},{"type":"text","id":"shipped_date","label":"2. Aşama Alt Metni","default":"1-2 gün içinde"},{"type":"text","id":"label_delivered","label":"3. Aşama","default":"Teslim Edildi"},{"type":"text","id":"delivered_date","label":"3. Aşama Alt Metni","default":"3-5 gün içinde"},{"type":"color","id":"active_color","label":"Vurgu Rengi","default":"#6366f1"},{"type":"color","id":"bg_color","label":"Kart Arka Planı","default":"#ffffff"},{"type":"color","id":"border_color","label":"Kenarlık Rengi","default":"#e2e8f0"},{"type":"color","id":"text_color","label":"Metin Rengi","default":"#0f172a"},{"type":"range","id":"title_size","min":12,"max":20,"step":1,"unit":"px","label":"Başlık Boyutu","default":15},{"type":"range","id":"step_size","min":11,"max":16,"step":1,"unit":"px","label":"Aşama Metin Boyutu","default":13},{"type":"range","id":"border_radius","min":0,"max":32,"step":2,"unit":"px","label":"Kenar Yuvarlatma","default":16},{"type":"range","id":"card_padding","min":12,"max":36,"step":2,"unit":"px","label":"İç Boşluk","default":20},{"type":"range","id":"margin_bottom","min":0,"max":40,"step":4,"unit":"px","label":"Alt Boşluk","default":16}]}
{% endschema %}
