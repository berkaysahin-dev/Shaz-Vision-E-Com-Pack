{{ 'vision-ui.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vision-ui.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  :root {
    --vision-color-primary: {{ block.settings.primary_color | default: '#6366f1' }};
    --vision-color-primary-hover: {{ block.settings.primary_color | default: '#4f46e5' }};
    {% if block.settings.custom_border_radius != blank %}
      --vision-radius-md: {{ block.settings.custom_border_radius }}px;
      --vision-radius-lg: {{ block.settings.custom_border_radius | plus: 4 }}px;
    {% endif %}
  }
  {{ block.settings.custom_css }}
{%- endstyle -%}

{%- if block.settings.enable_sticky_buy -%}
  <div id="vision-sticky-buy-bar" class="vision-sticky-bar vision-sticky-bar--{{ block.settings.sticky_position | default: 'bottom' }}" style="display: none;">
    <div class="vision-sticky-content">
      <div class="vision-sticky-info">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" class="vision-sticky-img" width="44" height="44" loading="lazy">
        {% else %}
          <div class="vision-sticky-img" style="background:#f1f5f9;display:flex;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
          </div>
        {% endif %}
        <div class="vision-sticky-titles">
          <span class="vision-sticky-title">{{ product.title | default: 'Örnek Ürün' }}</span>
          <span class="vision-sticky-price">{{ product.price | default: 29900 | money }}</span>
        </div>
      </div>
      <div class="vision-sticky-actions">
        <form method="post" action="{{ routes.cart_add_url }}" class="vision-sticky-form" style="margin:0;">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="vision-btn vision-btn-primary vision-sticky-btn" style="background-color: {{ block.settings.sticky_btn_color | default: '#6366f1' }}; color: {{ block.settings.sticky_btn_text_color | default: '#ffffff' }};">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
            <span>{{ block.settings.sticky_btn_text | default: 'Sepete Ekle' }}</span>
          </button>
        </form>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const stickyBar = document.getElementById('vision-sticky-buy-bar');
      if (!stickyBar) return;
      window.addEventListener('scroll', function() {
        stickyBar.style.display = (window.scrollY > 350) ? 'block' : 'none';
      }, { passive: true });
    });
  </script>
{%- endif -%}

{%- if block.settings.enable_sales_toast -%}
  <div id="vision-sales-toast" class="vision-toast" style="display:none;">
    <div class="vision-toast-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#6366f1" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
    </div>
    <div class="vision-toast-body">
      <p class="vision-toast-text">{{ block.settings.toast_template | default: 'Bir müşteri az önce bir ürün sipariş etti!' }}</p>
      <span class="vision-toast-time">Az önce • Doğrulanmış Sipariş</span>
    </div>
    <button class="vision-toast-close" onclick="document.getElementById('vision-sales-toast').style.display='none'" aria-label="Kapat">&times;</button>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const toast = document.getElementById('vision-sales-toast');
      if (!toast) return;
      setTimeout(function() {
        toast.style.display = 'flex';
        setTimeout(function() { toast.style.display = 'none'; }, {{ block.settings.toast_duration | default: 6 | times: 1000 }});
      }, {{ block.settings.toast_delay | default: 4 | times: 1000 }});
    });
  </script>
{%- endif -%}

{%- if block.settings.enable_whatsapp -%}
  <a href="https://wa.me/{{ block.settings.whatsapp_number }}" target="_blank" rel="noopener" class="vision-whatsapp-float" aria-label="WhatsApp Destek">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-0.981z"/></svg>
  </a>
{%- endif -%}

{% schema %}
{"name":"Vision Global Settings","target":"body","stylesheet":"vision-ui.css","javascript":"vision-ui.js","settings":[{"type":"header","content":"Genel Marka & Stil Ayarları"},{"type":"color","id":"primary_color","label":"Ana Vurgu Rengi","default":"#6366f1"},{"type":"range","id":"custom_border_radius","min":0,"max":24,"step":2,"unit":"px","label":"Kenar Yuvarlatma","default":12},{"type":"header","content":"Yapışkan Satın Al Barı"},{"type":"checkbox","id":"enable_sticky_buy","label":"Yapışkan Barı Etkinleştir","default":true},{"type":"select","id":"sticky_position","label":"Bar Konumu","options":[{"value":"bottom","label":"Ekran Altı"},{"value":"top","label":"Ekran Üstü"}],"default":"bottom"},{"type":"text","id":"sticky_btn_text","label":"Buton Metni","default":"Sepete Ekle"},{"type":"color","id":"sticky_btn_color","label":"Buton Rengi","default":"#6366f1"},{"type":"color","id":"sticky_btn_text_color","label":"Buton Yazı Rengi","default":"#ffffff"},{"type":"header","content":"Canlı Satış Bildirimi"},{"type":"checkbox","id":"enable_sales_toast","label":"Satış Bildirimini Aç","default":true},{"type":"text","id":"toast_template","label":"Bildirim Metni","default":"Müşterimiz az önce bu ürünü satın aldı!"},{"type":"range","id":"toast_delay","min":1,"max":20,"step":1,"unit":"sn","label":"Açılış Gecikmesi","default":3},{"type":"range","id":"toast_duration","min":3,"max":15,"step":1,"unit":"sn","label":"Ekranda Kalma Süresi","default":6},{"type":"header","content":"WhatsApp Butonu"},{"type":"checkbox","id":"enable_whatsapp","label":"WhatsApp Butonunu Göster","default":false},{"type":"text","id":"whatsapp_number","label":"WhatsApp Numarası","default":"905000000000"},{"type":"header","content":"Özel CSS Kodları"},{"type":"textarea","id":"custom_css","label":"Özel CSS Kodları"}]}
{% endschema %}
