    },
    {
      "type": "image_picker",
      "id": "spin_image_5",
      "label": "360° görsel 5"
    },
    {
      "type": "image_picker",
      "id": "spin_image_6",
      "label": "360° görsel 6"
    },
    {
      "type": "image_picker",
      "id": "spin_image_7",
      "label": "360° görsel 7"
