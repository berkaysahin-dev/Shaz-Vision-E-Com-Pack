{{ 'product-media-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-360-viewer.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign spin_count = 0
  for i in (1..12)
    assign key = 'spin_image_' | append: i
    assign img = section.settings[key]
    if img != blank
      assign spin_count = spin_count | plus: 1
    endif
  endfor

  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif

  assign has_3d_model = false
  assign model_media = product.media | where: 'media_type', 'model' | first
  if model_media != blank and section.settings.use_shopify_3d
    assign has_3d_model = true
  endif

  assign has_360 = false
  if spin_count > 1
    assign has_360 = true
  endif

  assign show_section = false
  if has_video or has_360 or has_3d_model
    assign show_section = true
  endif

  assign active_tab = ''
  if has_video
    assign active_tab = 'video'
  elsif has_360
    assign active_tab = 'spin360'
  elsif has_3d_model
    assign active_tab = 'model3d'
  endif
-%}

{% if show_section %}
  {%- if has_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}

  <div class="product-media-showcase color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {% if section.settings.heading != blank %}
        <h2 class="product-media-showcase__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if has_video and has_360 or has_video and has_3d_model or has_360 and has_3d_model %}
        <div class="product-media-showcase__tabs" role="tablist">
          {% if has_video %}
            <button type="button" class="product-media-showcase__tab{% if active_tab == 'video' %} is-active{% endif %}" role="tab" data-tab="video" aria-selected="{% if active_tab == 'video' %}true{% else %}false{% endif %}">
              {% render 'material-icon', icon: 'play_circle', filled: false %}
              {{ section.settings.video_tab_label }}
            </button>
          {% endif %}
          {% if has_360 %}
            <button type="button" class="product-media-showcase__tab{% if active_tab == 'spin360' %} is-active{% endif %}" role="tab" data-tab="spin360" aria-selected="{% if active_tab == 'spin360' %}true{% else %}false{% endif %}">
              {% render 'material-icon', icon: '360', filled: false %}
              {{ section.settings.spin_tab_label }}
            </button>
          {% endif %}
          {% if has_3d_model %}
            <button type="button" class="product-media-showcase__tab{% if active_tab == 'model3d' %} is-active{% endif %}" role="tab" data-tab="model3d" aria-selected="{% if active_tab == 'model3d' %}true{% else %}false{% endif %}">
              {% render 'material-icon', icon: 'view_in_ar', filled: false %}
              {{ section.settings.model_tab_label }}
            </button>
          {% endif %}
        </div>
      {% endif %}

      <div class="product-media-showcase__panels">
        {% if has_video %}
          <div class="product-media-showcase__panel{% if active_tab == 'video' %} is-active{% endif %}" data-panel="video" role="tabpanel">
            <div class="product-media-showcase__video">
              {% render 'video-player', block: section %}
            </div>
          </div>
        {% endif %}

        {% if has_360 %}
          <div class="product-media-showcase__panel{% if active_tab == 'spin360' %} is-active{% endif %}" data-panel="spin360" role="tabpanel">
            <product-360-viewer class="product-360-viewer" data-frame-count="{{ spin_count }}">
              <div class="product-360-viewer__canvas">
                {%- for i in (1..12) -%}
                  {%- assign key = 'spin_image_' | append: i -%}
                  {%- assign img = section.settings[key] -%}
                  {%- if img != blank -%}
                    {{
                      img
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        class: 'product-360-viewer__frame',
                        widths: '400, 600, 800, 1000, 1200',
                        sizes: '(min-width: 990px) 720px, 100vw',
                        alt: product.title
                    }}
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <div class="product-360-viewer__hint">
                {% render 'material-icon', icon: 'swipe', filled: false %}
                {{ section.settings.spin_hint }}
              </div>
            </product-360-viewer>
          </div>
        {% endif %}

        {% if has_3d_model %}
          <div class="product-media-showcase__panel{% if active_tab == 'model3d' %} is-active{% endif %}" data-panel="model3d" role="tabpanel">
            <div class="product-media-showcase__model">
              {{ model_media | media_tag: image_size: '800x', toggleable: true }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <script>
    (function () {
      const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl) return;
      const tabs = sectionEl.querySelectorAll('.product-media-showcase__tab');
      const panels = sectionEl.querySelectorAll('.product-media-showcase__panel');
      if (!tabs.length) return;

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          tabs.forEach((t) => {
            t.classList.toggle('is-active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          panels.forEach((panel) => {
            panel.classList.toggle('is-active', panel.dataset.panel === target);
          });
        });
      });
    })();
  </script>
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
